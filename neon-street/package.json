{
  "name": "neon-street",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Path-traced rainy cyberpunk street - a walk-around WebGPU graphics showcase",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "headless": "node scripts/headless.mjs",
    "app": "vite build && electron .",
    "app:smoke": "vite build && electron . --no-sandbox --smoke --launch=preset=low&w=320&h=180&autostart=1&hud=0",
    "package": "vite build && electron-builder --win",
    "package:linux": "vite build && electron-builder --linux"
  },
  "devDependencies": {
    "@webgpu/types": "^0.1.60",
    "electron": "^44.8.0",
    "electron-builder": "^25.1.8",
    "typescript": "^5.6.0",
    "vite": "^6.0.0"
  },
  "main": "electron/main.cjs",
  "author": "Noah and Lars",
  "build": {
    "appId": "dev.neonstreet.app",
    "productName": "Neon Street",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "electron/**",
      "package.json"
    ],
    "win": {
      "target": [
        "portable",
        "zip"
      ],
      "artifactName": "NeonStreet-${version}-${arch}.${ext}",
      "signAndEditExecutable": false
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Game"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Noah-and-Lars/projects.git"
  }
}

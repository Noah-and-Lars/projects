{
  "name": "tidewright",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Tidewright: a browser vehicle-building physics sandbox on a stormy island ocean.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "bench": "node tools/physics-bench.mjs",
    "e2e": "node tools/e2e.mjs"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "0.19.3",
    "three": "0.180.0"
  },
  "devDependencies": {
    "@types/three": "0.180.0",
    "typescript": "5.9.3",
    "vite": "7.3.8",
    "vitest": "3.2.7"
  }
}

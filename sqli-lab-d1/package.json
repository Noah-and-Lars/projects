{
  "name": "sqli-lab-d1",
  "version": "1.0.0",
  "private": true,
  "description": "Intentionally vulnerable SQL-injection lab backed by a REAL SQLite DB (Cloudflare D1). Valid sqlmap target. Fake data only.",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --config ./wrangler.toml",
    "seed:remote": "wrangler d1 execute sqli-lab-db --remote --file=./schema.sql --config ./wrangler.toml",
    "seed:local": "wrangler d1 execute sqli-lab-db --local --file=./schema.sql --config ./wrangler.toml",
    "deploy": "wrangler deploy --config ./wrangler.toml"
  },
  "devDependencies": {
    "wrangler": "^4.166.0"
  }
}
